{
  "name": "pi-learn-extensions",
  "version": "1.0.1",
  "description": "Pi Coding Agent extensions: repository Wiki, ChatGPT usage status, Aurora UI, and Midnight Aurora theme.",
  "type": "module",
  "scripts": {
    "test": "npm run test:wiki && npm run test:aurora && npm run test:theme",
    "test:wiki": "node --test tests/wiki/*.test.mjs tests/wiki/*.test.mts",
    "test:wiki:upstream": "bun test ./extensions/wiki/vendor/thinkrail-spec-graph/core/core.test.ts",
    "test:wiki:host": "node --test tests/wiki/wiki-host.smoke.mjs",
    "test:aurora": "node --test tests/aurora/*.test.mjs",
    "test:navigation": "node --test tests/navigation/*.test.mjs",
    "test:navigation:pty": "python3 tests/navigation/smoke.py && python3 tests/navigation/tree-smoke.py",
    "test:theme": "node --test tests/theme/*.test.mjs"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent"
  ],
  "license": "MIT",
  "pi": {
    "extensions": [
      "./extensions"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "files": [
    "extensions",
    "tests",
    "themes",
    "README.md"
  ],
  "dependencies": {
    "yaml": "2.9.1"
  }
}
